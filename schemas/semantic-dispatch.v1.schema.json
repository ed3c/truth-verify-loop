{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/truth-verify-loop/schemas/semantic-dispatch.v1.schema.json",
  "title": "Truth Verify Loop Semantic Dispatch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "runs", "aggregates", "totals"],
  "$defs": {
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "family",
        "provider",
        "provider_version",
        "model",
        "prompt_sha256",
        "instruction_hashes",
        "output_sha256",
        "started_at",
        "ended_at",
        "status",
        "exit_code",
        "timed_out",
        "attempt_kind",
        "usage"
      ],
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "succeeded"}}},
          "then": {
            "properties": {
              "exit_code": {"const": 0},
              "timed_out": {"const": false}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "timeout"}}},
          "then": {"properties": {"timed_out": {"const": true}}}
        },
        {
          "if": {
            "properties": {
              "status": {"enum": ["failed", "discarded"]}
            }
          },
          "then": {"properties": {"timed_out": {"const": false}}}
        }
      ],
      "properties": {
        "schema": {"const": "tvl.semantic-verifier-receipt.v1"},
        "family": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "provider_version": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "instruction_hashes": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "status": {"enum": ["succeeded", "failed", "timeout", "discarded"]},
        "exit_code": {"type": ["integer", "null"]},
        "timed_out": {"type": "boolean"},
        "attempt_kind": {"enum": ["primary", "recovery"]},
        "usage": {
          "type": "object",
          "additionalProperties": {"type": "number", "minimum": 0}
        },
        "command_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "failure_reason": {"type": "string", "minLength": 1},
        "stream_capture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["limit_bytes_per_channel", "stdout", "stderr"],
          "properties": {
            "limit_bytes_per_channel": {"type": "integer", "minimum": 1},
            "stdout": {"$ref": "#/$defs/capturedStream"},
            "stderr": {"$ref": "#/$defs/capturedStream"}
          }
        }
      }
    },
    "capturedStream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captured_bytes", "truncated"],
      "properties": {
        "captured_bytes": {"type": "integer", "minimum": 0},
        "truncated": {"type": "boolean"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "request_id",
        "evidence_id",
        "family",
        "verdict",
        "rationale_summary",
        "verifier_receipt_sha256"
      ],
      "properties": {
        "schema": {"const": "tvl.semantic-review.v1"},
        "request_id": {"type": "string", "minLength": 1},
        "evidence_id": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1},
        "verdict": {"enum": ["ENTAILS", "DOES_NOT_ENTAIL", "ABSTAIN"]},
        "rationale_summary": {"type": "string", "minLength": 1},
        "verifier_receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "properties": {
    "schema": {"const": "tvl.semantic-dispatch.v1"},
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "receipt",
          "receipt_sha256",
          "attempt_receipts",
          "reviews",
          "disposition",
          "reason"
        ],
        "properties": {
          "receipt": {"$ref": "#/$defs/receipt"},
          "receipt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "attempt_receipts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["receipt", "receipt_sha256"],
              "properties": {
                "receipt": {"$ref": "#/$defs/receipt"},
                "receipt_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "reviews": {
            "type": "array",
            "items": {"$ref": "#/$defs/review"}
          },
          "disposition": {
            "enum": ["accepted", "discarded", "ineligible"]
          },
          "reason": {
            "enum": [
              "accepted",
              "search_provider_identity",
              "search_provider_family",
              "duplicate_identity",
              "correlated_identity_conflict",
              "judge_correlated_identity",
              "status_failed",
              "status_timeout",
              "status_discarded"
            ]
          }
        }
      }
    },
    "aggregates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "verdict",
          "accepted_families",
          "policy_satisfied",
          "judge_family"
        ],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "verdict": {
            "enum": ["ENTAILS", "DOES_NOT_ENTAIL", "ABSTAIN", "DISAGREEMENT"]
          },
          "accepted_families": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "policy_satisfied": {"type": "boolean"},
          "judge_family": {"type": ["string", "null"]}
        }
      }
    },
    "totals": {
      "type": "object",
      "required": [
        "attempts",
        "failed_attempts",
        "timeout_attempts",
        "discarded_attempts",
        "recovery_attempts",
        "latency_seconds"
      ],
      "properties": {
        "attempts": {"type": "integer", "minimum": 0},
        "failed_attempts": {"type": "integer", "minimum": 0},
        "timeout_attempts": {"type": "integer", "minimum": 0},
        "discarded_attempts": {"type": "integer", "minimum": 0},
        "recovery_attempts": {"type": "integer", "minimum": 0},
        "judge_attempts": {"type": "integer", "minimum": 0},
        "latency_seconds": {"type": "number", "minimum": 0}
      },
      "additionalProperties": {"type": "number", "minimum": 0}
    }
  }
}
