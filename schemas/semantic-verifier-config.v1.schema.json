{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/truth-verify-loop/schemas/semantic-verifier-config.v1.schema.json",
  "title": "Truth Verify Loop Semantic Verifier Config v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "verifiers", "judge", "max_judge_requests"],
  "properties": {
    "schema": {"const": "tvl.semantic-verifier-config.v1"},
    "verifiers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/adapter"}
    },
    "judge": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/adapter"}
      ]
    },
    "max_judge_requests": {"type": "integer", "minimum": 1}
  },
  "$defs": {
    "nullableCanonicalText": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$"}
      ]
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "provider",
        "provider_version",
        "model",
        "command",
        "timeout_seconds",
        "max_attempts",
        "instruction_files"
      ],
      "properties": {
        "family": {"type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$"},
        "provider": {"type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$"},
        "provider_version": {"$ref": "#/$defs/nullableCanonicalText"},
        "model": {"$ref": "#/$defs/nullableCanonicalText"},
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000]+$"}
        },
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 3},
        "instruction_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          }
        }
      }
    }
  }
}
